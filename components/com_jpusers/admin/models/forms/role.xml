<?xml version="1.0" encoding="utf-8"?>
<form addfieldpath="/administrator/components/com_easyjobsmanager/models/fields" >
    <fieldset name="general">
        <field
                name="id"
                type="number"
                label="JGLOBAL_FIELD_ID_LABEL"
                description="JGLOBAL_FIELD_ID_DESC"
                class="readonly form-control"
                size="10"
                default="0"
                readonly="true"
        />
        <field
                name="title"
                label="COM_JOOMPROJECT_FIELD_TITLE_LABEL"
                type="title"
                class="form-control"
                required="true"
        />

        <field
                name="permissions"
                label="COM_JOOMPROJECT_FIELD_PERMISSIONS_LABEL"
                type="rolepermissions"
                class="form-control"
                required="true"
        />


    </fieldset>
    <field
            name="state"
            type="list"
            label="JSTATUS"
            description="JFIELD_PUBLISHED_DESC"
            class="chzn-color-state"
            filter="intval"
            size="1"
            default="1"
    >
        <option value="1">JPUBLISHED</option>
        <option value="0">JUNPUBLISHED</option>
        <option value="2">JARCHIVED</option>
        <option value="-2">JTRASHED</option>
    </field>

    <field
            name="created"
            type="calendar"
            label="COM_JOOMPROJECT_FIELD_CREATED_LABEL"
            description="COM_JOOMPROJECT_FIELD_CREATED_DESC"
            translateformat="true"
            showtime="true"
            size="22"
            filter="user_utc"
            class="form-control"
    />

    <field
            name="created_by"
            type="user"
            label="COM_JOOMPROJECT_FIELD_CREATED_BY_LABEL"
            description="COM_JOOMPROJECT_FIELD_CREATED_BY_DESC"
            class="form-control"
    />

    <field
            name="modified"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            description="COM_JOOMPROJECT_FIELD_MODIFIED_DESC"
            class="readonly form-control"
            translateformat="true"
            showtime="true"
            size="22"
            readonly="true"
            filter="user_utc"
    />

    <field
            name="modified_by"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            class="readonly form-control"
            readonly="true"
            filter="unset"
    />

    <field
            name="checked_out"
            type="hidden"
            filter="unset"
    />

    <field
            name="checked_out_time"
            type="hidden"
            filter="unset"
    />

    <field
            name="ordering"
            type="text"
            label="JFIELD_ORDERING_LABEL"
            description="JFIELD_ORDERING_DESC"
            size="6"
            default="0"
            class="form-control"
    />
</form>