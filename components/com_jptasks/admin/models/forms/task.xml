<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="task" addfieldpath="/administrator/components/com_joomproject/models/fields">
        <field
                name="project_id"
                type="project"
                label="COM_JOOMPROJECT_FIELD_PROJECT_LABEL"
                description="COM_JOOMPROJECT_FIELD_PROJECT_DESC"
                class="form-control"
                required="true"
                view="task"
                onchange="window.parent.JPform.reload('milestone_id,list_id,access,rules,labels,dependency,attachment');"
                select="true"
                clear="false"
                filter="integer"
        />
        <field name="milestone_id" type="milestone"
            label="COM_JOOMPROJECT_FIELD_MILESTONE_LABEL" description="COM_JOOMPROJECT_FIELD_MILESTONE_DESC"
            class=" form-select"
            onchange="window.parent.JPform.reload('list_id,access,rules');"
        />
        <field name="list_id" type="tasklist"
            label="COM_JOOMPROJECT_FIELD_TASKLIST_LABEL" description="COM_JOOMPROJECT_FIELD_TASKLIST_DESC"
            class=" form-select"
            onchange="window.parent.JPform.reload('milestone_id,access,rules');"
        />
        <field name="title" type="jptext"
            label="JGLOBAL_TITLE"
            class=" form-control" size="30" required="true"
        />
        <field name="description" type="jpeditor"
            label="COM_JOOMPROJECT_FIELD_DESCRIPTION_LABEL" description="COM_JOOMPROJECT_FIELD_DESCRIPTION_DESC"
            class=" form-control" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText"
        />
        <field name="created_by" type="jpuser"
            label="COM_JOOMPROJECT_FIELD_CREATED_BY_LABEL" description="COM_JOOMPROJECT_FIELD_CREATED_BY_DESC"
               class="form-control"
        />
        <field name="start_date" type="jpcalendar"
            label="COM_JOOMPROJECT_FIELD_START_DATE_LABEL" description="COM_JOOMPROJECT_FIELD_START_DATE_OPTIONAL_DESC"
            size="22" showtime="true" format="%Y-%m-%d %H:%M:%S" translateformat="true" filter="user_utc" class=" form-control"
        />
        <field name="end_date" type="jpcalendar"
            label="COM_JOOMPROJECT_FIELD_DEADLINE_LABEL" description="COM_JOOMPROJECT_FIELD_DEADLINE_OPTIONAL_LABEL"
            size="22" showtime="true" format="%Y-%m-%d %H:%M:%S" translateformat="true" filter="user_utc" class=" form-control"
        />
        <field name="estimate" type="jptext" size="10" default="1"
            label="COM_JOOMPROJECT_FIELD_TIME_ESTIMATE" class="form-conrol" description="COM_JOOMPROJECT_FIELD_TASK_TIME_ESTIMATE_DESC"
        />
        <field name="rate" type="money"
            label="COM_JOOMPROJECT_FIELD_RATE_LABEL" description="COM_JOOMPROJECT_FIELD_RATE_DESC" class="form-control"
        />
        <field name="attachment" type="repoattachment"
            label="COM_JOOMPROJECT_FIELD_ATTACHMENT_LABEL" description="COM_JOOMPROJECT_FIELD_ATTACHMENT_DESC"
        />
        <field name="labels" type="labels"
            label="COM_JOOMPROJECT_FIELD_LABELS" description="COM_JOOMPROJECT_FIELD_LABELS_DESC"
            asset="com_jptasks.task"
        />
        <field name="dependency" type="taskdependency" />

        <field name="modified" type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            class="readonly form-control" readonly="true"
            translateformat="true"
            showtime="true"
            filter="user_utc"
        />
        <field name="modified_by" type="jpuser"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            class="readonly" readonly="true" filter="unset"
        />
        <field name="priority" type="jplist"
            label="COM_JOOMPROJECT_FIELD_PRIORITY_LABEL" description="COM_JOOMPROJECT_FIELD_PRIORITY_DESC"
            class=" form-control" filter="intval" size="1" default="1"
        >
            <option value="1">COM_JOOMPROJECT_PRIORITY_VERY_LOW</option>
            <option value="2">COM_JOOMPROJECT_PRIORITY_LOW</option>
            <option value="3">COM_JOOMPROJECT_PRIORITY_MEDIUM</option>
            <option value="4">COM_JOOMPROJECT_PRIORITY_HIGH</option>
            <option value="5">COM_JOOMPROJECT_PRIORITY_VERY_HIGH</option>
        </field>

        <field name="users" type="userref" multiple="true" label="COM_JOOMPROJECT_FIELD_REFUSER_LABEL" description="COM_JOOMPROJECT_FIELD_REFUSER_TASK_DESC"/>
        <field name="rules" type="groupaccess"
            component="com_jptasks" section="task" inheritonly="true" filter="JPFormHelper::filterRules" validate="groupaccess"

        />
        <field name="id" type="hidden" readonly="true"/>
        <field name="access" type="inheritaccess" hidden="true" readonly="true"/>
        <field name="asset_id" type="hidden" filter="unset"/>
        <field name="alias" type="hidden" readonly="true"/>
        <field name="created" type="hidden" readonly="true"/>
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
        <field name="elements" type="hidden" />
    </fieldset>
    <fieldset name="completion">
        <field
                name="not_applicable"
                type="radio"
                label="COM_JPTASKS_FIELD_NOT_APPLICABLE_LABEL"
                description="COM_JPTASKS_FIELD_TASK_NOT_APPLICABLE_DESC"
                default="0"
                layout="joomla.form.field.radio.switcher"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field
                name="complete"
                type="radio"
                label="COM_JOOMPROJECT_FIELD_COMPLETE_LABEL"
                description="COM_JOOMPROJECT_FIELD_TASK_COMPLETE_DESC"
                default="0"
                showon="not_applicable:0"
                layout="joomla.form.field.radio.switcher"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

    </fieldset>
</form>
