<?xml version="1.0" encoding="utf-8"?>
<metadata>
	<layout title="COM_JPMILESTONES_MILESTONES_VIEW_DEFAULT_TITLE" option="COM_JPMILESTONES_MILESTONES_VIEW_DEFAULT_OPTION">
		<message><![CDATA[COM_JPMILESTONES_MILESTONES_VIEW_DEFAULT_DESC]]></message>
	</layout>

    <fields name="request">
        <fieldset name="request">
            <field name="filter_category" type="category" description="JGLOBAL_CHOOSE_CATEGORY_DESC" extension="com_jpmilestones" label="JGLOBAL_CHOOSE_CATEGORY_LABEL" required="false">
                <option value="">JALL</option>
            </field>
        </fieldset>
    </fields>


    <fields name="params">
        <fieldset name="advanced" label="COM_JPMILESTONES_MILESTONES_DEFAULT_LAYOUT_OPTIONS">
            <field name="show_filter" type="list" default="1" label="COM_JPPROJECTS_SHOW_FILTER">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="groupingType" type="list" default="project_id" label="Grouping Type">
                <option value="project_title">By Project</option>
                <option value="category_title">By Category</option>
            </field>
            <field name="filter_published" type="list" default="" label="JSTATUS">
                <option value="">JPUBLISHED</option>
                <option value="0">JUNPUBLISHED</option>
                <option value="2">JARCHIVED</option>
                <option value="-2">JTRASHED</option>
            </field>
            <field name="filter_order" type="list" default="" label="COM_JPMILESTONES_SORT_BY">
                <option value="">JDEFAULT</option>
                <option value="project_title, a.title">JGLOBAL_TITLE</option>
                <option value="a.end_date">COM_JOOMPROJECT_ORDER_DEADLINE</option>
                <option value="author_name">JAUTHOR</option>
            </field>
            <field name="filter_order_Dir" type="list" default="" label="COM_JPMILESTONES_ORDER">
                <option value="">JDEFAULT</option>
                <option value="ASC">JGLOBAL_ORDER_ASCENDING</option>
                <option value="DESC">JGLOBAL_ORDER_DESCENDING</option>
            </field>
            <field name="display_num" type="list" default="25" label="COM_JPMILESTONES_NUMBER_ITEMS_LIST_LABEL">
                <option value="5">J5</option>
                <option value="10">J10</option>
                <option value="15">J15</option>
                <option value="20">J20</option>
                <option value="25">J25</option>
                <option value="30">J30</option>
                <option value="50">J50</option>
                <option value="100">J100</option>
                <option value="0">JALL</option>
            </field>
        </fieldset>
    </fields>
</metadata>