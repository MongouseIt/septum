<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>
        <field name="project_id" type="project"
            label="COM_JOOMPROJECT_FIELD_PROJECT_LABEL" description="COM_JOOMPROJECT_FIELD_PROJECT_DESC"
            class="inputbox form-control" size="30" required="true"
            onchange="JPform.reload('access,rules,album_id,labels');"
        />
        <field name="file" type="jpfile"
            label="COM_JOOMPROJECT_FIELD_MEDIA_LABEL" description="COM_JOOMPROJECT_FIELD_MEDIA_DESC"
            class="inputbox form-control" size="30"
        />

        <field name="thumbnail" type="jpfile"
               label="COM_JOOMPROJECT_FIELD_CUSTOM_THUMB_LABEL" description="COM_JOOMPROJECT_FIELD_MEDIA_DESC"
               class="inputbox form-control" size="30"
        />
        <field name="title" type="jptext"
            label="JGLOBAL_TITLE" description="JFIELD_TITLE_DESC"
            class="inputbox form-control" size="30"
        />
        <field name="description" type="editor"
            label="COM_JOOMPROJECT_FIELD_DESCRIPTION_LABEL" description="COM_JOOMPROJECT_FIELD_DESCRIPTION_DESC"
            buttons="true" class="inputbox form-control" filter="\Joomla\CMS\Component\ComponentHelper::filterText"
        />
        <field name="labels" type="labels"
            label="COM_JOOMPROJECT_FIELD_LABELS" description="COM_JOOMPROJECT_FIELD_LABELS_DESC"
            asset="com_jpdesigns.design"
        />
        <field name="state" type="jplist"
            label="JSTATUS" description="JFIELD_PUBLISHED_DESC"
            class="inputbox form-control" filter="intval" size="1" default="1"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field name="album_id" type="designalbum"
            label="JGRID_HEADING_DESIGN_ALBUM"  class="form-control" description="COM_JOOMPROJECT_FIELD_DESIGN_ALBUM_DESC"
            onchange="JPform.reload('access,rules');"
        >
        </field>
        <field name="created_by" type="jpuser"
            label="COM_JOOMPROJECT_FIELD_CREATED_BY_LABEL" description="COM_JOOMPROJECT_FIELD_CREATED_BY_DESC" class="form-control"
        />
        <field name="modified" type="jpcalendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" class="readonly form-control"
        />
        <field name="modified_by" type="jpuser"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            class="readonly form-control" readonly="true" filter="unset"
        />
        <field name="rules" type="designgroups"
            component="com_jpdesigns" section="design" inheritonly="true" filter="JPFormHelper::filterRules" validate="groupaccess"

        />
        <field name="id" type="hidden" readonly="true"/>
        <field name="asset_id" type="hidden" filter="unset"/>
        <field name="access" type="designaccess" hidden="true" readonly="true"/>
        <field name="elements" type="hidden"/>
        <field name="alias" type="hidden" readonly="true"/>
        <field name="created" type="hidden" readonly="true"/>
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
        <field name="file_name" type="hidden" hidden="true" readonly="true"/>
    </fieldset>
</form>
