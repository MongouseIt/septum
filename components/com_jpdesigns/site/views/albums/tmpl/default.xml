			    label="COM_JPDESIGNS_CONFIG_DESIGNS_ALBUM_ROW_LIMIT_LABEL" description="COM_JPDESIGNS_CONFIG_DESIGNS_ALBUM_ROW_LIMIT_DESC">
			    <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="1">1</option>
                <option value="2">2</option>
			    <option value="3">3</option>
			    <option value="4">4</option>
            </field>
            <field name="album_row_items" type="list"
			label="COM_JPDESIGNS_CONFIG_DESIGNS_ALBUM_ROW_ITEMS_LABEL" description="COM_JPDESIGNS_CONFIG_DESIGNS_ALBUM_ROW_ITEMS_DESC">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="1">1</option>
                <option value="2">2</option>
			    <option value="3">3</option>
			    <option value="4">4</option>
			    <option value="6">6</option>
            </field>
            <field name="album_items_sort" type="list"
			label="COM_JPDESIGNS_CONFIG_DESIGNS_ALBUM_ITEMS_SORT_LABEL" description="COM_JPDESIGNS_CONFIG_DESIGNS_ALBUM_ITEMS_SORT_DESC">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="0">Ordering</option>
                <option value="1">Oldest first</option>
			    <option value="2">Newest first</option>
            </field>
            <field name="album_row_fill" type="list"
			label="COM_JPDESIGNS_CONFIG_DESIGNS_ROW_FILL_LABEL" description="COM_JPDESIGNS_CONFIG_DESIGNS_ROW_FILL_DESC">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field name="album_row_upload" type="list"
			label="COM_JPDESIGNS_CONFIG_DESIGNS_UPLOAD_LABEL" description="COM_JPDESIGNS_CONFIG_DESIGNS_UPLOAD_DESC">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="0">JNO</option>
                <option value="1">JYES</option>
