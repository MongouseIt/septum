<?xml version="1.0" encoding="utf-8"?>
<metadata>
	<layout title="COM_JPDESIGNS_ALBUMS_VIEW_DEFAULT_TITLE" option="COM_JPDESIGNS_ALBUMS_VIEW_DEFAULT_OPTION">
		<message><![CDATA[COM_JPDESIGNS_ALBUMS_VIEW_DEFAULT_DESC]]></message>
	</layout>
    <!-- Add fields to the parameters object for the layout. -->
    <fields name="params">
        <fieldset name="albums" label="COM_JPDESIGNS_DESIGN_PREVIEW_OPTIONS">
