<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset addfieldpath="administrator/components/com_joomproject/models/fields">
		<field name="description" type="jptextarea" class=" form-control"
			label="COM_JOOMPROJECT_FIELD_DESCRIPTION_LABEL" description="COM_JOOMPROJECT_FIELD_DESCRIPTION_DESC"
			buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText"
		/>
		<field name="state" type="jplist" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="form-control"
			filter="intval" size="1" default="1"
		>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
        <field name="created_by" type="jpuser"
			label="COM_JOOMPROJECT_FIELD_CREATED_BY_LABEL" description="COM_JOOMPROJECT_FIELD_CREATED_BY_DESC" class="form-control"
        />
		<field name="modified" type="jpcalendar" class="readonly form-control"
			label="JGLOBAL_FIELD_MODIFIED_LABEL"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc"
        />
		<field name="modified_by" type="jpuser"
		    label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
		    class="readonly form-control"
		    readonly="true"
		    filter="unset"
		/>

        <field name="asset_id" type="hidden" filter="unset"/>
		<field name="id" type="hidden"/>
		<field name="project_id" type="hidden" readonly="true"/>
		<field name="title" type="hidden" readonly="true"/>
		<field name="item_id" type="hidden" readonly="true"/>
		<field name="context" type="hidden" readonly="true"/>
		<field name="created" type="hidden"/>
        <field name="parent_id" type="hidden" readonly="true"/>

		<field name="lft" type="hidden" filter="unset"/>
		<field name="rgt" type="hidden" filter="unset"/>
		<field name="level" type="hidden" filter="unset"/>
		<field name="checked_out" type="hidden" filter="unset" />
		<field name="checked_out_time" type="hidden" filter="unset" />

	</fieldset>
	<fields name="attribs">

	</fields>
</form>