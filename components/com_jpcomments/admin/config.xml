<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="general" label="COM_JPCOMMENTS_CONFIG_GENERAL_LABEL">
        <field name="enable_in" multiple="true" type="list" default="" label="COM_JPCOMMENTS_CONFIG_ENABLE_IN" description="COM_JPCOMMENTS_CONFIG_ENABLE_IN_DESC">
            <option value="com_jpprojects.project">COM_JPCOMMENTS_PROJECT_DASHBOARD</option>
            <option value="com_jpmilestones.milestone">COM_JPCOMMENTS_MILESTONE</option>
            <option value="tasklist">COM_JPCOMMENTS_TASKLIST</option>
            <option value="com_jptasks.task">COM_JPCOMMENTS_TASK</option>
            <option value="com_jprepo.directory">COM_JPCOMMENTS_DIRECTORY</option>
            <option value="com_jprepo.note">COM_JPCOMMENTS_NOTE</option>
            <option value="com_jpdesigns.design">COM_JPCOMMENTS_DESIGN</option>
            <option value="com_jpdesigns.revision">COM_JPCOMMENTS_REVISION</option>
            <option value="com_jpusers.user">COM_JPCOMMENTS_USER</option>
        </field>

        <field name="project_dash_comments_display" type="radio" default="0" class="btn-group btn-group-yesno" label="COM_JPCOMMENTS_DISPLAY_PROJECT_DASH_COMMENTS_AS">
            <option value="0">COM_JPCOMMENTS_AS_TAB</option>
            <option value="1">COM_JPCOMMENTS_INSIDE_VIEW</option>
        </field>

    </fieldset>
    <fieldset name="list" label="COM_JPCOMMENTS_CONFIG_LIST_LABEL">
        <field name="filter_order_Dir" type="list" default="ASC" label="COM_JPCOMMENTS_ORDER">
            <option value="ASC">JGLOBAL_ORDER_ASCENDING</option>
            <option value="DESC">JGLOBAL_ORDER_DESCENDING</option>
        </field>
    </fieldset>
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field name="rules" type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			class="inputbox" validate="rules" filter="rules"
			component="com_jpcomments" section="component"
        />
	</fieldset>
</config>