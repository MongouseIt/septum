<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_JPREMINDERS_FILTER_SEARCH_LABEL"
			hint="JSEARCH_FILTER"
		/>

		<field
				name="author_id"
				type="author"
				label="COM_JPREMINDERS_SELECT_AUTHOR"
				placeholder="COM_JPREMINDERS_SELECT_AUTHOR"
				class="multipleAuthors"
				onchange="this.form.submit();"
		>
			<option value="">COM_JPREMINDERS_SELECT_AUTHOR</option>
		</field>

		<field
				name="state"
				type="list"
				label="COM_CONTENT_FILTER_PUBLISHED"
				description="COM_CONTENT_FILTER_PUBLISHED_DESC"
				onchange="this.form.submit();"
		>
			<option value="">COM_JPREMINDERS_FILTER_SELECT_STATE</option>
			<option value="0">COM_JPREMINDERS_FINISHED</option>
			<option value="1">COM_JPREMINDERS_PROGRESS</option>
		</field>

	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="COM_JPREMINDERS_LIST_FULL_ORDERING"
			description="COM_JPREMINDERS_LIST_FULL_ORDERING_DESC"
			onchange="this.form.submit();"
			default="r.id DESC"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="t.title ASC">COM_JPREMINDERS_TASK_NAME_ASC</option>
			<option value="t.title DESC">COM_JPREMINDERS_TASK_NAME_DESC</option>
			<option value="r.created_by ASC">JAUTHOR_ASC</option>
			<option value="r.created_by DESC">JAUTHOR_DESC</option>
			<option value="r.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="r.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="r.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="COM_JPREMINDERS_LIST_LIMIT"
			description="COM_JPREMINDERS_LIST_LIMIT_DESC"
			class="input-mini"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
