<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
                name="search"
                type="text"
                inputmode="search"
                label="COM_JOOMPROJECT_FILTER_SEARCH_LABEL"
                description="COM_JOOMPROJECT_FILTER_SEARCH_DESC"
                hint="JSEARCH_FILTER"
        />
        <field
                name="published"
                type="status"
                label="JOPTION_SELECT_PUBLISHED"
                onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>
        <field
                name="client_id"
                type="list"
                label="JOPTION_SELECT_PUBLISHED"
                onchange="this.form.submit();"
        >
            <option value="0">JSITE</option>
            <option value="1">JADMINISTRATOR</option>
        </field>
        <field
                name="event_id"
                type="events"
                label="JOPTION_SELECT_EVENT"
                hint="JOPTION_SELECT_EVENT"
                onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_EVENT</option>

        </field>
        <field
                name="extension"
                type="extensions"
                label="JOPTION_SELECT_EXTENSION"
                hint="JOPTION_SELECT_EXTENSION"
                onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_EXTENSION</option>

        </field>
        <field
                name="access"
                type="accesslevel"
                label="JGRID_HEADING_ACCESS"
                hint="JOPTION_SELECT_ACCESS"
                onchange="this.form.submit();"
                >
        <option value="">JOPTION_SELECT_ACCESS</option>
        </field>

    </fields>

    <fields name="list">
        <field
                name="fullordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                onchange="this.form.submit();"
                default="a.created DESC"
                validate="options"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.created ASC">JDATE_ASC</option>
            <option value="a.created DESC">JDATE_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                default="25"
                onchange="this.form.submit();"
        />
    </fields>
</form>
