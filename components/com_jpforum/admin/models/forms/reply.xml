<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset addfieldpath="administrator/components/com_joomproject/models/fields">
        <field name="description" type="editor"
            label="COM_JOOMPROJECT_FIELD_DESCRIPTION_LABEL" description="COM_JOOMPROJECT_FIELD_DESCRIPTION_DESC"
            class=" form-control" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText"
        />
        <field name="state" type="jplist"
            label="JSTATUS" description="JFIELD_PUBLISHED_DESC"
            class=" form-control" filter="intval" size="1" default="1"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field name="created_by" type="jpuser"
            label="COM_JOOMPROJECT_FIELD_CREATED_BY_LABEL" class="form-control" description="COM_JOOMPROJECT_FIELD_CREATED_BY_DESC"
        />
        <field name="modified" type="jpcalendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            class="readonly form-control" size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc"
        />
        <field name="modified_by" type="jpuser"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            class="readonly form-control" readonly="true" filter="unset"
        />
        <field name="attachment" type="repoattachment"
            label="COM_JOOMPROJECT_FIELD_ATTACHMENT_LABEL" description="COM_JOOMPROJECT_FIELD_ATTACHMENT_DESC"
        />
        <field name="rules" type="groupaccess"
            component="com_jpforum" class="form-control" section="reply" inheritonly="true" filter="JPFormHelper::filterRules" validate="groupaccess"

        />
        <field name="id" type="hidden" readonly="true"/>
        <field name="project_id" type="hidden" readonly="true"/>
        <field name="topic_id" type="hidden" readonly="true"/>
        <field name="access" type="inheritaccess" hidden="true" readonly="true"/>
        <field name="asset_id" type="hidden" filter="unset"/>
        <field name="elements" type="hidden"/>
        <field name="created" type="hidden" readonly="true"/>
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
    </fieldset>
</form>
