<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
				name="search"
				type="text"
				inputmode="search"
				label="COM_JOOMPROJECT_FILTER_SEARCH_LABEL"
				description="COM_JOOMPROJECT_FILTER_SEARCH_DESC"
				hint="JSEARCH_FILTER"
		/>
		<field
				name="published"
				type="status"
				label="JOPTION_SELECT_PUBLISHED"
				onchange="this.form.submit();"
		>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>


		<field
				name="access"
				type="accesslevel"
				label="JGRID_HEADING_ACCESS"
				hint="JOPTION_SELECT_ACCESS"
				onchange="this.form.submit();"
		>
			<option value="">JOPTION_SELECT_ACCESS</option>
		</field>

	</fields>

	<fields name="list">
		<field
				name="project_id"
				type="projectid"
				label=""
				hint="JOPTION_SELECT_PROJECT"
		/>
		<field
				name="fullordering"
				type="list"
				label="JGLOBAL_SORT_BY"
				onchange="this.form.submit();"
				default="a.id DESC"
				validate="options"
		>
			<option value="">JGLOBAL_SORT_BY</option>

			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="access_level ASC">JGRID_HEADING_ACCESS_ASC</option>
			<option value="access_level DESC">JGRID_HEADING_ACCESS_DESC</option>
			<option value="replies ASC">JGRID_HEADING_RESPLIES_ASC</option>
			<option value="replies DESC">JGRID_HEADING_RESPLIES_DESC</option>
			<option value="author_name ASC">JAUTHOR_ASC</option>
			<option value="author_name DESC">JAUTHOR_DESC</option>
			<option value="a.created ASC">JDATE_ASC</option>
			<option value="a.created DESC">JDATE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
				name="limit"
				type="limitbox"
				label="JGLOBAL_LIST_LIMIT"
				default="25"
				onchange="this.form.submit();"
		/>
	</fields>
</form>
