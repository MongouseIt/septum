<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="project" addfieldpath="administrator/components/com_joomproject/models/fields">
        <field name="title" type="jptext"
            label="JGLOBAL_TITLE"
            class=" form-control" size="30" required="true"
        />
        <field name="description" type="editor"
            label="COM_JOOMPROJECT_FIELD_DESCRIPTION_LABEL" description="COM_JOOMPROJECT_FIELD_DESCRIPTION_DESC"
            buttons="true" class=" form-control" filter="\Joomla\CMS\Component\ComponentHelper::filterText"
        />
        <field name="state" type="jplist"
            label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="form-control" filter="intval" size="1" default="1"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field name="catid" type="jpcategory"
            label="JCATEGORY" description="COM_JOOMPROJECT_FIELD_CATEGORY_DESC"
            extension="com_jpprojects" class=" form-control"
        >
        </field>
        <field name="created_by" type="jpuser"
            label="COM_JOOMPROJECT_FIELD_CREATED_BY_LABEL" description="COM_JOOMPROJECT_FIELD_CREATED_BY_DESC"
        />
        <field name="start_date" type="calendar"
            label="COM_JOOMPROJECT_FIELD_START_DATE_LABEL" description="COM_JOOMPROJECT_FIELD_START_DATE_OPTIONAL_DESC"
            filter="user_utc" translateformat="true"
               showtime="true"
        />
        <field name="end_date" type="calendar"
            label="COM_JOOMPROJECT_FIELD_DEADLINE_LABEL" description="COM_JOOMPROJECT_FIELD_DEADLINE_OPTIONAL_LABEL"
           filter="user_utc" translateformat="true"
               showtime="true"
        />
        <field
                name="modified"
                type="calendar"
                label="JGLOBAL_FIELD_MODIFIED_LABEL"
                class="form-control"
                translateformat="true"
                showtime="true"
                readonly="true"
                filter="user_utc"
        />
        <field name="modified_by" type="jpuser"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            class="readonly" readonly="true" filter="unset"
        />
        <field name="attachment" type="repoattachment"
            label="COM_JOOMPROJECT_FIELD_ATTACHMENT_LABEL" description="COM_JOOMPROJECT_FIELD_ATTACHMENT_DESC"
        />
        <field name="rules" type="groupaccess"
            component="com_jpprojects" section="project" inheritonly="false" filter="JPFormHelper::filterRules" validate="groupaccess"
        />
        <field name="component_rules" type="hidden" filter="JPFormHelper::filterComponentRules"/>
        <field name="labels" type="labelmanager"
            label="COM_JOOMPROJECT_FIELD_LABELS" description="COM_JOOMPROJECT_FIELD_LABELS_MANAGER_DESC"
        />
        <field type="jpgallery" name="gallery" label="COM_JOOMPROJECT_FIELD_GALLERY" readonly="false"/>
        <field name="id" type="hidden" readonly="true"/>
        <field name="asset_id" type="hidden" filter="unset"/>
        <field name="access" type="hidden" readonly="true"/>
        <field name="elements" type="hidden"/>
        <field name="alias" type="hidden" readonly="true"/>
        <field name="created" type="hidden" readonly="true"/>
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
        <field name="add_groupuser" type="hidden" readonly="true" />
        <field name="rm_groupuser" type="hidden" readonly="true" />
    </fieldset>

    <fields name="attribs">
        <fieldset name="basic" label="COM_JOOMPROJECT_DETAILS_FIELDSET">
            <field name="repo_dir" type="hidden" filter="int"/>
        </fieldset>

        <fieldset name="details">
            <field name="logo" type="projectlogo"
                   label="COM_JOOMPROJECT_FIELD_PROJECT_IMG_LABEL" description="COM_JOOMPROJECT_FIELD_PROJECT_IMG_DESC"
                   class=" form-control"
            />
            <field name="website" type="jptext"
                   label="COM_JOOMPROJECT_FIELD_WEBSITE_LABEL" description="COM_JOOMPROJECT_FIELD_PROJECT_WEBSITE_DESC"
                   class=" form-control" size="30" filter="url"
            />
            <field name="email" type="jptext"
                   label="COM_JOOMPROJECT_FIELD_EMAIL_LABEL" description="COM_JOOMPROJECT_FIELD_PROJECT_EMAIL_DESC"
                   class=" form-control" size="30" filter="email"
            />
            <field name="phone" type="jptext"
                   label="COM_JOOMPROJECT_FIELD_PHONE_LABEL" description="COM_JOOMPROJECT_FIELD_PROJECT_PHONE_DESC"
                   class=" form-control" size="30"
            />
        </fieldset>

        <fieldset name="display">
            <field name="project_color" type="jpcolor"
                   default=""
                   description="COM_JOOMPROJECT_FIELD_PROJECT_OVERVIEW_COLOR_DESC"
                   label="COM_JOOMPROJECT_FIELD_PROJECT_OVERVIEW_COLOR_LABEL"
                   class="form-control jscolor"
            />
            <field name="milestone_color" type="jpcolor"
                   default=""
                   description="COM_JOOMPROJECT_FIELD_PROJECT_MILESTONE_COLOR_DESC"
                   label="COM_JOOMPROJECT_FIELD_PROJECT_MILESTONE_COLOR_LABEL"
                   class="form-control jscolor"
            />
            <field name="tasklist_color" type="jpcolor"
                   default=""
                   description="COM_JOOMPROJECT_FIELD_PROJECT_TLIST_COLOR_DESC"
                   label="COM_JOOMPROJECT_FIELD_PROJECT_TLIST_COLOR_LABEL"
                   class="form-control jscolor"
            />
            <field name="task_color" type="jpcolor"
                   default=""
                   description="COM_JOOMPROJECT_FIELD_PROJECT_TASK_COLOR_DESC"
                   label="COM_JOOMPROJECT_FIELD_PROJECT_TASK_COLOR_LABEL"
                   class="form-control jscolor"
            />
        </fieldset>


        <fieldset name="currency">
            <field type="jptext" name="currency_code" label="COM_JOOMPROJECT_CONFIG_CURRENCY_CODE_LABEL"   class="form-control" description="COM_JOOMPROJECT_CONFIG_CURRENCY_CODE_DESC" default="" maxlength="3" size="10"/>
            <field type="jptext" name="currency_sign" label="COM_JOOMPROJECT_CONFIG_CURRENCY_SIGN_LABEL" description="COM_JOOMPROJECT_CONFIG_CURRENCY_SIGN_DESC"  class="form-control" default="" maxlength="2" size="10"/>
            <field name="currency_position" type="jplist" label="COM_JOOMPROJECT_CONFIG_CURRENCY_POS_LABEL" description="COM_JOOMPROJECT_CONFIG_CURRENCY_POS_DESC" class="form-control">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="0">COM_JOOMPROJECT_CONFIG_CURRENCY_POS_BEFORE_OPTION</option>
                <option value="1">COM_JOOMPROJECT_CONFIG_CURRENCY_POS_AFTER_OPTION</option>
            </field>
            <field type="jptext" name="decimal_delimiter"  class="form-control" label="COM_JOOMPROJECT_CONFIG_DECIMAL_DELIMITER_LABEL" description="COM_JOOMPROJECT_CONFIG_DECIMAL_DELIMITER_DESC" default=""  maxlength="1" size="10"/>
            <field type="jptext" name="thousands_delimiter" class="form-control" label="COM_JOOMPROJECT_CONFIG_THOUSANDS_DELIMITER_LABEL" description="COM_JOOMPROJECT_CONFIG_THOUSANDS_DELIMITER_DESC" default="" maxlength="1" size="10"/>
        </fieldset>

    </fields>
</form>
