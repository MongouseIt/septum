<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5" client="site" method="upgrade">
	<name>mod_jp_taskcounter</name>
	<author>JoomBoost</author>
	<creationDate>02/12/2018</creationDate>
	<copyright>Copyright (C) 2018 JoomBoost. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>support@joomboost.com</authorEmail>
	<authorUrl>https://www.joomboost.com</authorUrl>
	<version>5.11.0</version>
	<description>MOD_JP_TASKCOUNTER_XML_DESCRIPTION</description>
    <position>jp-dashboard-right</position>
    <published>1</published>
    <show_title>1</show_title>
    <scriptfile>script.php</scriptfile>
	<files>
		<filename module="mod_jp_taskcounter">mod_jp_taskcounter.php</filename>
		<folder>tmpl</folder>
		<filename>helper.php</filename>
		<filename>script.php</filename>
		<filename>mod_jp_taskcounter.xml</filename>
	</files>
	<languages>
            <language tag="en-GB">language/en-GB/mod_jp_taskcounter.ini</language>
            <language tag="en-GB">language/en-GB/mod_jp_taskcounter.sys.ini</language>
	</languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field type="text" name="prepend_text" default="You have" label="MOD_JP_TASKCOUNTER_CONFIG_PREPEND_TEXT_LABEL" description="MOD_JP_TASKCOUNTER_CONFIG_PREPEND_TEXT_DESC"/>
                <field type="text" name="append_text" default="tasks to be done" label="MOD_JP_TASKCOUNTER_CONFIG_APPEND_TEXT_LABEL" description="MOD_JP_TASKCOUNTER_CONFIG_APPEND_TEXT_DESC"/>
                <field type="list" name="link" default="" label="MOD_JP_TASKCOUNTER_CONFIG_LINK_LABEL" description="MOD_JP_TASKCOUNTER_CONFIG_LINK_DESC">
                    <option value="">JNO</option>
                    <option value="1">MOD_JP_TASKCOUNTER_CONFIG_LINK_NUMBER</option>
                    <option value="2">MOD_JP_TASKCOUNTER_CONFIG_LINK_TEXT_NUMBER</option>
                </field>
                <field type="text" name="link_class" default="btn btn-small btn-warning" label="MOD_JP_TASKCOUNTER_CONFIG_LINK_CLASS_LABEL" description="MOD_JP_TASKCOUNTER_CONFIG_LINK_CLASS_DESC"/>
                <field type="project" name="filter_project" default="" addfieldpath="administrator/components/com_jpprojects/models/fields" label="MOD_JP_TASKCOUNTER_CONFIG_FILTER_PROJECT_LABEL" description="MOD_JP_TASKCOUNTER_CONFIG_FILTER_PROJECT_DESC"/>
                <field type="list" name="filter_progress" default="" label="MOD_JP_TASKCOUNTER_CONFIG_FILTER_PROGRESS_LABEL">
                    <option value="">MOD_JP_TASKCOUNTER_CONFIG_NO_FILTER</option>
                    <option value="1">MOD_JP_TASKCOUNTER_CONFIG_FILTER_COMPLETE_ONLY_LABEL</option>
                    <option value="0">MOD_JP_TASKCOUNTER_CONFIG_FILTER_INCOMPLETE_ONLY_LABEL</option>
                </field>
                <field type="list" name="filter_assignee" default="0" label="MOD_JP_TASKCOUNTER_CONFIG_FILTER_ASSIGNEE_LABEL">
                    <option value="0">MOD_JP_TASKCOUNTER_CONFIG_NO_FILTER</option>
                    <option value="1">MOD_JP_TASKCOUNTER_CONFIG_FILTER_ASSIGNED_TO_ME_LABEL</option>
                </field>
                <field type="list" name="filter_schedule" default="0" label="MOD_JP_TASKCOUNTER_CONFIG_FILTER_SCHEDULE_LABEL">
                    <option value="0">MOD_JP_TASKCOUNTER_CONFIG_NO_FILTER</option>
                    <option value="1">MOD_JP_TASKCOUNTER_CONFIG_FILTER_SCHEDULE_OVERDUE</option>
                </field>
                <field type="list" name="filter_priority" default="" label="MOD_JP_TASKCOUNTER_CONFIG_FILTER_PRIORITY_LABEL">
                    <option value="">MOD_JP_TASKCOUNTER_CONFIG_NO_FILTER</option>
                    <option value="1">MOD_JP_TASKCOUNTER_CONFIG_FILTER_PRIORITY_VERY_LOW</option>
                    <option value="2">MOD_JP_TASKCOUNTER_CONFIG_FILTER_PRIORITY_LOW</option>
                    <option value="3">MOD_JP_TASKCOUNTER_CONFIG_FILTER_PRIORITY_MEDIUM</option>
                    <option value="4">MOD_JP_TASKCOUNTER_CONFIG_FILTER_PRIORITY_HIGH</option>
                    <option value="5">MOD_JP_TASKCOUNTER_CONFIG_FILTER_PRIORITY_VERY_HIGH</option>
                </field>
                <field type="radio" name="filter_published" default="1" class="btn-group" label="MOD_JP_TASKCOUNTER_CONFIG_COUNT_PUBLISHED_LABEL">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field type="radio" name="filter_unpublished" default="0" class="btn-group" label="MOD_JP_TASKCOUNTER_CONFIG_COUNT_UNPUBLISHED_LABEL">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field type="radio" name="filter_archived" default="0" class="btn-group" label="MOD_JP_TASKCOUNTER_CONFIG_COUNT_ARCHIVED_LABEL">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field type="radio" name="filter_trashed" default="0" class="btn-group" label="MOD_JP_TASKCOUNTER_CONFIG_COUNT_TRASHED_LABEL">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC" />
				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
				<field
					name="cache"
					type="list"
					default="1"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option
						value="1">JGLOBAL_USE_GLOBAL</option>
					<option
						value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
				<field
					name="cache_time"
					type="text"
					default="900"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC" />
				<field
					name="cachemode"
					type="hidden"
					default="static">
					<option
						value="static"></option>
				</field>
            </fieldset>
        </fields>
    </config>
</extension>
