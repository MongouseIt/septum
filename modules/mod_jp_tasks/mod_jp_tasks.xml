<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5" client="site" method="upgrade">
	<name>mod_jp_tasks</name>
	<author>JoomBoost</author>
	<creationDate>03-03-2018</creationDate>
	<copyright>Copyright (C) 2012-2019 JoomBoost. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>support@joomboost.com</authorEmail>
	<authorUrl>https://www.joomboost.com</authorUrl>
	<version>5.11.0</version>
	<description>MOD_JP_TASKS_XML_DESCRIPTION</description>
    <position>jp-dashboard-left</position>
    <published>1</published>
    <show_title>1</show_title>
    <scriptfile>script.php</scriptfile>
	<files>
		<filename module="mod_jp_tasks">mod_jp_tasks.php</filename>
		<folder>tmpl</folder>
		<filename>helper.php</filename>
		<filename>script.php</filename>
		<filename>mod_jp_tasks.xml</filename>
	</files>
	<languages>
            <language tag="en-GB">language/en-GB/mod_jp_tasks.ini</language>
            <language tag="en-GB">language/en-GB/mod_jp_tasks.sys.ini</language>
	</languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field type="radio" name="tasks_of" default="0" class="btn-group"
                    label="MOD_JP_TASKS_CONFIG_TASKS_OF_LABEL"
                    description="MOD_JP_TASKS_CONFIG_TASKS_OF_DESC"
                >
                    <option value="0">MOD_JP_TASKS_CONFIG_TASKS_OF_CURRENT_LABEL</option>
                    <option value="1">MOD_JP_TASKS_CONFIG_TASKS_OF_SPECIFIC_LABEL</option>
                </field>
                <field type="project" name="project" default="" addfieldpath="administrator/components/com_jpprojects/models/fields"
                    label="MOD_JP_TASKS_CONFIG_PROJECT_LABEL" description="MOD_JP_TASKS_CONFIG_PROJECT_DESC"
                />
                <field type="list" name="filter_complete" default=""
                    label="MOD_JP_TASKS_CONFIG_FILTER_COMPLETE_LABEL"
                >
                    <option value="1">MOD_JP_TASKS_CONFIG_FILTER_COMPLETE_ONLY_LABEL</option>
                    <option value="0">MOD_JP_TASKS_CONFIG_FILTER_INCOMPLETE_ONLY_LABEL</option>
                    <option value="">MOD_JP_TASKS_CONFIG_FILTER_SHOW_ALL_LABEL</option>
                </field>
                <field type="list" name="sort" default=""
                    label="MOD_JP_TASKS_CONFIG_SORT_LABEL"
                >
                    <option value="a.end_date">MOD_JP_TASKS_CONFIG_SORT_END_DATE_LABEL</option>
                    <option value="a.start_date">MOD_JP_TASKS_CONFIG_SORT_START_DATE_LABEL</option>
                    <option value="a.priority">MOD_JP_TASKS_CONFIG_SORT_PRIORITY_LABEL</option>
                </field>
                <field type="list" name="order" default="ASC"
                    label="MOD_JP_TASKS_CONFIG_ORDER_LABEL"
                >
                    <option value="ASC">MOD_JP_TASKS_CONFIG_ORDER_ASC_LABEL</option>
                    <option value="DESC">MOD_JP_TASKS_CONFIG_ORDER_DESC_LABEL</option>
                </field>
                <field type="list" name="count" default="10"
                    label="MOD_JP_TASKS_CONFIG_COUNT_LABEL"
                >
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                    <option value="25">25</option>
                </field>
                <field type="list" name="show_tasks" default="3"
                       label="MOD_JP_TASKS_CONFIG_SHOW_TASKS"
                >
                    <option value="0">MOD_JP_TASKS_CONFIG_SHOW_ASSIGNED_TO_ME</option>
                    <option value="1">MOD_JP_TASKS_CONFIG_SHOW_CREATED_BY_ME</option>
                    <option value="2">MOD_JP_TASKS_CONFIG_SHOW_ASSIGNED_CREATED</option>
                    <option value="3">MOD_JP_TASKS_CONFIG_SHOW_ALL</option>
                </field>

                <field type="radio" name="group_by_list" default="0" class="btn-group"
                       label="Group by Task Lists"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field type="radio" name="show_assigned" default="0" class="btn-group"
                    label="MOD_JP_TASKS_CONFIG_SHOW_ASSIGNED_LABEL"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field type="radio" name="show_priority" default="0" class="btn-group"
                    label="MOD_JP_TASKS_CONFIG_SHOW_PRIORITY_LABEL"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field type="radio" name="show_deadline" default="1" class="btn-group"
                    label="MOD_JP_TASKS_CONFIG_SHOW_DEADLINE_LABEL"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="enable_quicklogtime" class="btn-group" type="radio" default="0" label="MOD_JP_TASKS_CONFIG_ENABLE_QUICKLOGTIME">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                        name="layout"
                        type="modulelayout"
                        label="JFIELD_ALT_LAYOUT_LABEL"
                        class="form-select"
                        validate="moduleLayout"
                />

                <field
                        name="moduleclass_sfx"
                        type="textarea"
                        label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                        rows="3"
                        validate="CssIdentifier"
                />

                <field
                        name="cache"
                        type="list"
                        label="COM_MODULES_FIELD_CACHING_LABEL"
                        default="1"
                        filter="integer"
                        validate="options"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                        name="cache_time"
                        type="number"
                        label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                        default="900"
                        filter="integer"
                />

                <field
                        name="cachemode"
                        type="hidden"
                        default="static"
                >
                    <option value="static"></option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
