<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5" client="site" method="upgrade">
	<name>mod_jp_gantt</name>
	<author>JoomBoost</author>
	<creationDate>02/12/2018</creationDate>
	<copyright>Copyright (C) 2012-2018 JoomBoost. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>support@joomboost.com</authorEmail>
	<authorUrl>https://www.joomboost.com</authorUrl>
	<version>5.11.0</version>
	<description>MOD_JP_GANTT_XML_DESCRIPTION</description>
    <position>jp-dashboard-top</position>
    <published>1</published>
    <show_title>1</show_title>
    <scriptfile>script.php</scriptfile>
	<files>
		<filename module="mod_jp_gantt">mod_jp_gantt.php</filename>
		<folder>helpers</folder>
        <folder>tmpl</folder>
		<filename>helper.php</filename>
		<filename>script.php</filename>
		<filename>mod_jp_gantt.xml</filename>
	</files>
	<languages>
            <language tag="en-GB">language/en-GB/mod_jp_gantt.ini</language>
            <language tag="en-GB">language/en-GB/mod_jp_gantt.sys.ini</language>
	</languages>
    <media destination="mod_jp_gantt" folder="media">
        <folder>css</folder>
        <folder>img</folder>
        <folder>js</folder>
		<filename>joomla.asset.json</filename>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="mode" type="list" class="inputbox"
				    label="MOD_JP_GANTT_FIELD_MODE_LABEL"
				    description="MOD_JP_GANTT_FIELD_MODE_DESC"
				    default="0"
			    >
				    <option value="0">MOD_JP_GANTT_FIELD_MODE_DYNAMIC</option>
				    <option value="1">MOD_JP_GANTT_FIELD_MODE_MANUAL</option>
		        </field>
                <field type="project" name="project" default="" addfieldpath="administrator/components/com_jpprojects/models/fields"
                    label="MOD_JP_GANTT_FIELD_PROJECT_LABEL" description="MOD_JP_GANTT_FIELD_PROJECT_DESC"
                />
                <field name="limit" type="list" class="inputbox input-small"
				    label="MOD_JP_GANTT_FIELD_LIMIT_LABEL"
				    description="MOD_JP_GANTT_FIELD_LIMIT_DESC"
				    default="20"
			    >
				    <option value="0">JALL</option>
				    <option value="10">10</option>
				    <option value="15">15</option>
				    <option value="20">20</option>
				    <option value="25">25</option>
				    <option value="30">30</option>
				    <option value="40">40</option>
				    <option value="50">50</option>
		        </field>
                <field name="column_width" type="text" class="inputbox input-small"
                    label="MOD_JP_GANTT_FIELD_COLUMN_WIDTH_LABEL"
				    description="MOD_JP_GANTT_FIELD_COLUMN_WIDTH_DESC"
                    default="225"
                />
                <field name="slider_width" type="text" class="inputbox input-small"
                    label="MOD_JP_GANTT_FIELD_SLIDER_WIDTH_LABEL"
				    description="MOD_JP_GANTT_FIELD_SLIDER_WIDTH_DESC"
                    default="300"
                />
                <field name="highlight_today" type="radio"
					   layout="joomla.form.field.radio.switcher"
    				default="1"
    				label="MOD_JP_GANTT_FIELD_HIGHLIGHT_TODAY_LABEL"
    				description="MOD_JP_GANTT_FIELD_HIGHLIGHT_TODAY_DESC"
                >
    				<option value="0">JNO</option>
    				<option value="1">JYES</option>
    			</field>
            </fieldset>
            <fieldset name="jp_gantt_overview" description="COM_MODULES_JP_GANTT_OVERVIEW_FIELDSET_DESC">
                <field name="show_overview" type="radio"
					   layout="joomla.form.field.radio.switcher"
    				default="1"
    				label="MOD_JP_GANTT_FIELD_SHOW_OVERVIEW_LABEL"
    				description="MOD_JP_GANTT_FIELD_SHOW_OVERVIEW_DESC"
                >
    				<option value="0">JNO</option>
    				<option value="1">JYES</option>
    			</field>
                <field name="filter_project_author" type="radio"
					   layout="joomla.form.field.radio.switcher"
    				default="0"
    				label="MOD_JP_GANTT_FIELD_FILTER_PROJECT_AUTHOR_LABEL"
    				description="MOD_JP_GANTT_FIELD_FILTER_PROJECT_AUTHOR_DESC"
                >
    				<option value="0">JNO</option>
    				<option value="1">JYES</option>
    			</field>
                <field name="filter_project_complete" type="radio"
					   layout="joomla.form.field.radio.switcher"
    				default="1"
    				label="MOD_JP_GANTT_FIELD_FILTER_PROJECT_COMPLETE_LABEL"
    				description="MOD_JP_GANTT_FIELD_FILTER_PROJECT_COMPLETE_DESC"
                >
    				<option value="0">JNO</option>
    				<option value="1">JYES</option>
    			</field>
            </fieldset>
            <fieldset name="jp_gantt_detail" description="COM_MODULES_JP_GANTT_DETAIL_FIELDSET_DESC">
                <field name="show_milestones" type="list" multiple="true"
					   layout="joomla.form.field.list-fancy-select"
    				default=""
    				label="MOD_JP_GANTT_FIELD_SHOW_MILESTONES_LABEL"
    				description="MOD_JP_GANTT_FIELD_SHOW_MILESTONES_DESC"
                >
    				<option value="-1">JHIDE</option>
    				<option value="1">JPUBLISHED</option>
    				<option value="0">JUNPUBLISHED</option>
    				<option value="2">JARCHIVED</option>
    			</field>
                <field name="show_lists" type="list" multiple="true"
    				default=""
					   layout="joomla.form.field.list-fancy-select"
    				label="MOD_JP_GANTT_FIELD_SHOW_LISTS_LABEL"
    				description="MOD_JP_GANTT_FIELD_SHOW_LISTS_DESC"
                >
    				<option value="-1">JHIDE</option>
    				<option value="1">JPUBLISHED</option>
    				<option value="0">JUNPUBLISHED</option>
    				<option value="2">JARCHIVED</option>
    			</field>
                <field name="show_tasks" type="list" multiple="true"
					   layout="joomla.form.field.list-fancy-select"
    				default=""
    				label="MOD_JP_GANTT_FIELD_SHOW_TASKS_LABEL"
    				description="MOD_JP_GANTT_FIELD_SHOW_TASKS_DESC"
                >
    				<option value="-1">JHIDE</option>
    				<option value="1">JPUBLISHED</option>
    				<option value="0">JUNPUBLISHED</option>
    				<option value="2">JARCHIVED</option>
    			</field>
                <field name="ms_display" type="list"
    				default="0"
    				label="MOD_JP_GANTT_FIELD_MS_DISPLAY_LABEL"
    				description="MOD_JP_GANTT_FIELD_MS_DISPLAY_DESC"
                >
    				<option value="0">MOD_JP_GANTT_FIELD_MS_DISPLAY_BAR</option>
    				<option value="1">MOD_JP_GANTT_FIELD_MS_DISPLAY_DOT</option>
    			</field>
                <field name="task_dependencies" type="list"
    				default="2"
    				label="MOD_JP_GANTT_FIELD_DISPLAY_TASK_DEP_LABEL"
    				description="MOD_JP_GANTT_FIELD_DISPLAY_TASK_DEP_DESC"
                >
    				<option value="0">MOD_JP_GANTT_FIELD_DISPLAY_TASK_DEP_NEVER</option>
    				<option value="1">MOD_JP_GANTT_FIELD_DISPLAY_TASK_DEP_ALWAYS</option>
    				<option value="2">MOD_JP_GANTT_FIELD_DISPLAY_TASK_DEP_HOVER</option>
    			</field>
            </fieldset>
            <fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC"
					class="form-select"
					validate="moduleLayout"
				/>

				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
				<field
					name="cache"
					type="list"
					default="0"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option
						value="1">JGLOBAL_USE_GLOBAL</option>
					<option
						value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
				<field
					name="cache_time"
					type="text"
					default="900"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC" />
				<field
					name="cachemode"
					type="hidden"
					default="static">
					<option
						value="static"></option>
				</field>
            </fieldset>
        </fields>
    </config>
</extension>
