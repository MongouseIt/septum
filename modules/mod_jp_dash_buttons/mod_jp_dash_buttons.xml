<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5" client="site" method="upgrade">
	<name>mod_jp_dash_buttons</name>
	<author>JoomBoost</author>
	<creationDate>03-03-2018</creationDate>
	<copyright>Copyright (C) 2012-2018 JoomBoost. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>support@joomboost.com</authorEmail>
	<authorUrl>https://www.joomboost.com</authorUrl>
	<version>5.11.0</version>
	<description>MOD_JP_DASH_BUTTONS_XML_DESCRIPTION</description>
    <position>jp-dashboard-top</position>
    <published>1</published>
    <show_title>0</show_title>
    <scriptfile>script.php</scriptfile>
	<files>
		<filename module="mod_jp_dash_buttons">mod_jp_dash_buttons.php</filename>
		<folder>tmpl</folder>
		<filename>helper.php</filename>
		<filename>script.php</filename>
		<filename>mod_jp_dash_buttons.xml</filename>
	</files>
	<languages>
            <language tag="en-GB">language/en-GB/mod_jp_dash_buttons.ini</language>
            <language tag="en-GB">language/en-GB/mod_jp_dash_buttons.sys.ini</language>
	</languages>
    <config>
        <fields name="params">
            <fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC" />
				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
				<field
					name="cache"
					type="list"
					default="1"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option
						value="1">JGLOBAL_USE_GLOBAL</option>
					<option
						value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
				<field
					name="cache_time"
					type="text"
					default="900"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					description="COM_MODULES_FIELD_CACHE_TIME_DESC" />
				<field
					name="cachemode"
					type="hidden"
					default="static">
					<option
						value="static"></option>
				</field>
            </fieldset>
        </fields>
    </config>
</extension>
