<?xml version="1.0" encoding="utf-8"?>
<extension version="3.3" type="plugin" group="content" method="upgrade">
	<name>PLG_CONTENT_JPREMINDERS</name>
	<creationDate>15/05/2019</creationDate>
	<author>JoomBoost</author>
	<copyright>(C) 2012 - 2018 JoomBoost. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see	LICENSE.txt</license>
	<authorEmail>support@joomboost.com</authorEmail>
	<authorUrl>https://www.joomboost.com</authorUrl>
	<version>5.11.0</version>
	<description>PLG_CONTENT_JPREMINDERS_XML_DESCRIPTION</description>
    <scriptfile>script.php</scriptfile>
	<files>
        <filename plugin="jpreminders">jpreminders.php</filename>
        <filename>script.php</filename>
        <folder>cli</folder>
	</files>
    <languages>
            <language tag="en-GB">language/en-GB/plg_content_jpreminders.ini</language>
            <language tag="en-GB">language/en-GB/plg_content_jpreminders.sys.ini</language>
    </languages>
    <config>
		<fields name="params">
			<fieldset name="basic">
                <field name="send_method"
					type="radio"
                    class="btn-group"
					default="0"
					description="PLG_CONTENT_JPREMINDERS_FIELD_SEND_METHOD_DESC"
					label="PLG_CONTENT_JPREMINDERS_FIELD_SEND_METHOD_LABEL"
                >
                    <option value="0">PLG_CONTENT_JPREMINDERS_FIELD_SEND_METHOD_DIRECT</option>
                    <option value="1">PLG_CONTENT_JPREMINDERS_FIELD_SEND_METHOD_CRON</option>
                </field>
                <field name="use_joomla_cache"
                       showon="send_method:0"
                       type="radio"
                       class="btn-group"
                       default="1"
                       label="PLG_CONTENT_JPREMINDERS_FIELD_USE_JOOMLA_LANGUAGE_LABEL"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field showon="send_method:1" type="text" name="cron_limit" default="20"
                    size="10"
                    class="input-small"
                    label="PLG_CONTENT_JPREMINDERS_FIELD_CRON_LIMIT_LABEL"
                    description="PLG_CONTENT_JPREMINDERS_FIELD_CRON_LIMIT_DESC"
                />

            </fieldset>
        </fields>
   </config>
</extension>